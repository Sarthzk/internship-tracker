# Copy to .env for local runs. In GitHub Actions these come from repository secrets.
# Any missing value makes that step skip with a warning instead of crashing.

GROQ_API_KEY=
GROQ_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_CHAT_ID=

# Optional tuning (defaults shown in comments)
# ENRICH_MAX_PER_RUN=40
# CLOSE_AFTER_MISSES=3
